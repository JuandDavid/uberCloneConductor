{
  "expo": {
    "name": "UberClone Conductor",
    "slug": "uberclone-conductor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación requiere acceso a la galería para adjuntar fotos y documentos.",
          "cameraPermission": "La aplicación requiere acceso a la cámara para tomar fotografías de los documentos."
        }
      ]
    ]
  }
}
